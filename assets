---

@import "{{ site.theme }}";

:root {
  --navy: #163a5f;
  --blue: #245f98;
  --text: #303846;
  --muted: #687586;
  --border: #e3e8ee;
  --soft: #f7f9fc;
  --white: #ffffff;
}

/* ===== General ===== */

body {
  background: var(--white);
  color: var(--text);
  font-family:
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    "Helvetica Neue",
    Arial,
    sans-serif;
  font-size: 16px;
  line-height: 1.72;
}

.wrapper {
  width: 1080px;
  max-width: 94%;
}

section {
  width: 745px;
}

header {
  width: 245px;
}

/* ===== Typography ===== */

h1 {
  color: var(--navy);
  font-size: 2.55rem;
  line-height: 1.1;
  font-weight: 720;
  letter-spacing: -0.035em;
  margin-bottom: 0.35rem;
}

h2 {
  color: var(--navy);
  font-size: 1.5rem;
  line-height: 1.25;
  margin-top: 2.8rem;
  margin-bottom: 1.2rem;
  padding-bottom: 0.4rem;
  border-bottom: 2px solid var(--border);
}

h3 {
  color: var(--blue);
  font-size: 1.13rem;
  margin-top: 2rem;
  margin-bottom: 1rem;
}

p {
  margin: 0.75rem 0 1rem;
}

strong {
  font-weight: 650;
}

/* ===== Links ===== */

a {
  color: var(--blue);
  text-decoration: none;
}

a:hover {
  color: var(--navy);
  text-decoration: underline;
}

/* ===== Hero ===== */

.hero {
  margin: 0 0 2rem;
  padding: 0.4rem 0 0.8rem;
}

.subtitle {
  color: #536171;
  font-size: 1.07rem;
  margin-bottom: 0.25rem;
}

.research-title {
  color: var(--navy);
  font-size: 1.02rem;
  font-weight: 650;
  margin-bottom: 1.15rem;
}

/* ===== Top buttons ===== */

.profile-links {
  margin-top: 1.1rem;
}

.profile-links a {
  display: inline-block;
  padding: 6px 12px;
  margin: 0 5px 6px 0;

  border: 1px solid #cbd5df;
  border-radius: 7px;

  background: #fff;
  color: var(--navy);

  font-size: 0.88rem;
  font-weight: 550;

  transition:
    background 0.15s ease,
    color 0.15s ease,
    border 0.15s ease;
}

.profile-links a:hover {
  background: var(--navy);
  border-color: var(--navy);
  color: white;
  text-decoration: none;
}

/* ===== Research box ===== */

.research-box {
  background: var(--soft);
  border-left: 4px solid var(--navy);
  border-radius: 4px;
  padding: 0.8rem 1.25rem 1rem;
  margin: 2rem 0;
}

.research-box h3 {
  margin-top: 0.3rem;
}

.research-box ul {
  margin-bottom: 0.25rem;
}

/* ===== Publications ===== */

section p + p {
  margin-top: 0.9rem;
}

section > p strong:first-child {
  color: #202a36;
}

section em {
  color: #222e3b;
}

/* make publication blocks breathe */
section h3 ~ p {
  margin-bottom: 1.25rem;
}

/* ===== Rules ===== */

hr {
  border: 0;
  height: 1px;
  background: var(--border);
  margin: 2.2rem 0;
}

/* ===== Footer ===== */

.footer-note {
  color: var(--muted);
  font-size: 0.82rem;
  text-align: center;
  margin-top: 2rem;
}

/* ===== Minimal-theme sidebar ===== */

header h1,
header p.view {
  display: none;
}

header p {
  color: var(--muted);
}

header ul {
  display: none;
}

/* ===== Mobile ===== */

@media print, screen and (max-width: 960px) {

  div.wrapper {
    width: auto;
    margin: 0;
  }

  header,
  section {
    float: none;
    position: static;
    width: auto;
  }

  header {
    padding-right: 0;
  }

  section {
    border: 0;
    margin: 0;
    padding: 15px 0;
  }
}

@media print, screen and (max-width: 480px) {

  body {
    padding: 18px;
    font-size: 15px;
  }

  h1 {
    font-size: 2rem;
  }

  h2 {
    font-size: 1.32rem;
  }

  .subtitle {
    font-size: 0.98rem;
  }

  .profile-links a {
    font-size: 0.82rem;
    padding: 5px 9px;
  }
}
